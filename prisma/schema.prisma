generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//  Enum pour les rôles
enum Role {
  CANDIDATE
  RECRUITER
  HR_MANAGER
  ADMIN
}

// Enum pour les statuts
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  password     String
  firstName    String     @default("") @map("first_name")
  lastName     String     @default("") @map("last_name")
  phone        String?
  role         Role       @default(CANDIDATE)
  status       UserStatus @default(ACTIVE)
  refreshToken String?    @map("refresh_token")
  lastLogin    DateTime?  @map("last_login")

  mustChangePassword Boolean @default(false) @map("must_change_password")
  

//  Champs pour la réinitialisation du mot de passe
  resetToken       String?   @db.Text
  resetTokenExpiry DateTime?

  // Relations
  jobsCreated  Job[]         @relation("JobCreator")
  applications Application[] @relation("CandidateApplications")
  interviews   Interview[]   @relation("UserInterviews")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("users")
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

enum ContractType {
  CDI
  CDD
  STAGE
  ALTERNANCE
  FREELANCE
}

model Job {
  id              Int          @id @default(autoincrement())
  title           String
  description     String       @db.Text
  requirements    String       @db.Text
  location        String
  contractType    ContractType
  salaryMin       Int?         @map("salary_min")
  salaryMax       Int?         @map("salary_max")
  experienceYears Int          @map("experience_years")
  educationLevel  String       @map("education_level")
  skills          String[] // Array PostgreSQL

  status JobStatus @default(DRAFT)

  // Qui a créé l'offre
  createdById Int  @map("created_by_id")
  createdBy   User @relation("JobCreator", fields: [createdById], references: [id])

  // Relations
  applications Application[]

  publishedAt DateTime?

  hrFeedback String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  closedAt  DateTime? @map("closed_at")

  @@map("jobs")
}

model Application {
  id    Int @id @default(autoincrement())
  jobId Int @map("job_id")
  job   Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  candidateId Int  @map("candidate_id")
  candidate   User @relation("CandidateApplications", fields: [candidateId], references: [id])

  cvPath String @map("cv_path")
  coverLetter String? @map("cover_letter") @db.Text
  aiMatchScore  Float?        // Score de matching (0-100)
  aiAnalysis    Json?         // Analyse détaillée IA (JSON)
  status ApplicationStatus @default(SUBMITTED)

  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  interviews Interview[]

  @@map("applications")
}

enum ApplicationStatus {
  SUBMITTED               // Candidature soumise
  SHORTLISTED             // Pré-sélectionné par recruteur
  INTERVIEW_HR_SCREENING  // Entretien RH #1 planifié/en cours
  INTERVIEW_TECHNICAL     // Entretien technique planifié/en cours
  INTERVIEW_HR_FINAL      // Entretien RH final planifié/en cours
  ACCEPTED                // Accepté (offre d'embauche)
  REJECTED                // Rejeté (fin du processus)
}

model Interview {
  id Int @id @default(autoincrement())

  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id])

  type        InterviewType
  scheduledAt DateTime

  duration Int?
  location String?
  notes    String?

  status InterviewStatus @default(SCHEDULED)

  evaluation  String?   // Évaluation détaillée
  passed      Boolean?  // true = validé, false = échoué
  completedAt DateTime? // Date de fin d'évaluation

  interviewerId Int
  interviewer   User @relation("UserInterviews", fields: [interviewerId], references: [id])

  createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt
}

enum InterviewType {
  HR_SCREENING   // Entretien RH initial (communication, langue)
  TECHNICAL      // Entretien technique (compétences)
  HR_FINAL       // Entretien RH final (négociation salaire)
}


enum InterviewStatus {
  SCHEDULED      // Planifié
  COMPLETED      // Terminé (en attente d'évaluation)
  PASSED         // Validé (candidat a réussi)
  FAILED         // Échoué (candidat n'a pas réussi)
  CANCELLED      // Annulé
}
