generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//  Enum pour les rôles
enum Role {
  CANDIDATE
  RECRUITER
  HR_MANAGER
  ADMIN
}

// Enum pour les statuts
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  password     String
  firstName    String     @default("") @map("first_name")
  lastName     String     @default("") @map("last_name")
  phone        String?
  role         Role       @default(CANDIDATE)
  status       UserStatus @default(ACTIVE)
  refreshToken String?    @map("refresh_token")
  lastLogin    DateTime?  @map("last_login")

  mustChangePassword Boolean @default(false) @map("must_change_password")

  // Relations
  jobsCreated  Job[]         @relation("JobCreator")
  applications Application[] @relation("CandidateApplications")
  interviews   Interview[]   @relation("UserInterviews")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("users")
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

enum ContractType {
  CDI
  CDD
  STAGE
  ALTERNANCE
  FREELANCE
}

model Job {
  id              Int          @id @default(autoincrement())
  title           String
  description     String       @db.Text
  requirements    String       @db.Text
  location        String
  contractType    ContractType
  salaryMin       Int?         @map("salary_min")
  salaryMax       Int?         @map("salary_max")
  experienceYears Int          @map("experience_years")
  educationLevel  String       @map("education_level")
  skills          String[] // Array PostgreSQL

  status JobStatus @default(DRAFT)

  // Qui a créé l'offre
  createdById Int  @map("created_by_id")
  createdBy   User @relation("JobCreator", fields: [createdById], references: [id])

  // Relations
  applications Application[]

  publishedAt DateTime?

  hrFeedback String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  closedAt  DateTime? @map("closed_at")

  @@map("jobs")
}

model Application {
  id    Int @id @default(autoincrement())
  jobId Int @map("job_id")
  job   Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  candidateId Int  @map("candidate_id")
  candidate   User @relation("CandidateApplications", fields: [candidateId], references: [id])

  cvPath      String? @map("cv_path")
  coverLetter String? @map("cover_letter") @db.Text

  status ApplicationStatus @default(SUBMITTED)

  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  interviews Interview[]

  @@map("applications")
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  INTERVIEW_SCHEDULED
  ACCEPTED
  REJECTED
}

model Interview {
  id Int @id @default(autoincrement())

  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id])

  type        InterviewType
  scheduledAt DateTime

  duration Int?
  location String?
  notes    String?

  status InterviewStatus @default(SCHEDULED)

  evaluation  String?
  passed      Boolean?
  completedAt DateTime?

  interviewerId Int
  interviewer   User @relation("UserInterviews", fields: [interviewerId], references: [id])

  createdAt DateTime @default(now())
}

enum InterviewType {
  HR_SCREENING
  INTERVIEW_TECHNICAL
  HR_FINAL

  HR
  TECHNICAL
  FINAL
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  PASSED
  FAILED
  CANCELLED
}
